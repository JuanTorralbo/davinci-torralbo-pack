{
	Tools = ordered() {
		BlurDip = GroupOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "BlurAmt",
					Source = "SecondOperand",
					Name = "Desenfoque",
					Default = 106.6666667,
				},
				Input2 = InstanceInput {
					SourceOp = "DipAmt",
					Source = "SecondOperand",
					Name = "Intensidad del blanco",
					Default = 0.34,
				},
				MainInput1 = InstanceInput {
					SourceOp = "Dis",
					Source = "Background",
				},
				MainInput2 = InstanceInput {
					SourceOp = "Dis",
					Source = "Foreground",
				}
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Dip",
					Source = "Output",
				}
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				MixC = LUTLookup {
					CtrlWZoom = false,
					Inputs = {
						Source = Input { Value = FuID { "Transition" }, },
						Curve = Input { Value = FuID { "Easing" }, },
						EaseIn = Input { Value = FuID { "Expo" }, },
						EaseOut = Input { Value = FuID { "Expo" }, },
						Lookup = Input {
							SourceOp = "MixCLookup",
							Source = "Value",
						},
					},
				},
				MixCLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.3333333333, 0.3333333333 } },
							[1] = { 1, LH = { 0.6666666667, 0.6666666667 } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
				Dis = Dissolve {
					Transitions = {
						[0] = "DFTDissolve"
					},
					CtrlWZoom = false,
					Inputs = {
						Mix = Input { SourceOp = "MixC", Source = "Value", },
					},
					ViewInfo = OperatorInfo { Pos = { -90, 50 } },
				},
				EnvC = LUTLookup {
					CtrlWZoom = false,
					Inputs = {
						Source = Input { Value = FuID { "Transition" }, },
						Curve = Input { Value = FuID { "Custom" }, },
						EaseIn = Input { Value = FuID { "Sine" }, },
						EaseOut = Input { Value = FuID { "Sine" }, },
						Lookup = Input {
							SourceOp = "EnvCLookup",
							Source = "Value",
						},
					},
				},
				EnvCLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.13, 0.62 } },
							[0.34] = { 1, LH = { 0.23, 1 }, RH = { 0.45, 1 } },
							[0.66] = { 1, LH = { 0.55, 1 }, RH = { 0.77, 1 } },
							[1] = { 0, LH = { 0.87, 0.62 } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
				Mov = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "Dis", Source = "Output", },
						Blend = Input { SourceOp = "EnvC", Source = "Value", },
						Size = Input { Value = 1.025, },
					},
					ViewInfo = OperatorInfo { Pos = { 40, 50 } },
				},
				BlurAmt = Calculation {
					CtrlWZoom = false,
					Inputs = {
						FirstOperand = Input { SourceOp = "EnvC", Source = "Value", },
						SecondOperand = Input { Value = 106.6666667, },
						Operator = Input { Value = 2, },
					},
					ViewInfo = OperatorInfo { Pos = { 170, 50 } },
				},
				Blr = Blur {
					CtrlWZoom = false,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						Input = Input { SourceOp = "Mov", Source = "Output", },
						XBlurSize = Input { SourceOp = "BlurAmt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 300, 50 } },
				},
				White = Background {
					CtrlWZoom = false,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 2160, },
						Height = Input { Value = 3840, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 90 } },
				},
				DipAmt = Calculation {
					CtrlWZoom = false,
					Inputs = {
						FirstOperand = Input { SourceOp = "EnvC", Source = "Value", },
						SecondOperand = Input { Value = 0.34, },
						Operator = Input { Value = 2, },
					},
					ViewInfo = OperatorInfo { Pos = { -90, 90 } },
				},
				Dip = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "Blr", Source = "Output", },
						Foreground = Input { SourceOp = "White", Source = "Output", },
						Blend = Input { SourceOp = "DipAmt", Source = "Result", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 40, 90 } },
				},
			},
		}
	},
	ActiveTool = "BlurDip"
}
