						CharacterSpacing = Input { Value = 0.98, },
						Center = Input { Value = { 0.5, 0.17 }, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Alpha1 = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { -220, 49 } },
				},
				TBlurAnim = BezierSpline {
					SplineColor = { Red = 233, Green = 166, Blue = 63 },
					NameSet = true,
					KeyFrames = {
						[0] = { 1, RH = { 10.72, 0 } },
						[67] = { 0, LH = { 20.1, 0 } },
						[293] = { 0, RH = { 306.4, 0 } },
						[360] = { 1, LH = { 346.6, 1 } }
					}
				},
				TBlurCalc = Calculation {
					CtrlWZoom = false,
					Inputs = {
						FirstOperand = Input { Expression = "1 - min(min(max((time - comp.RenderStart) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1), min(max((comp.RenderEnd - time) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1))", },
						SecondOperand = Input { Value = 60.08888889, },
						Operator = Input { Value = 2, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 49 } },
				},
				TBlur = Blur {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "TText", Source = "Output", },
						XBlurSize = Input { SourceOp = "TBlurCalc", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 49 } },
				},
				TXfSize = BezierSpline {
					SplineColor = { Red = 114, Green = 159, Blue = 207 },
					NameSet = true,
					KeyFrames = {
						[0] = { 1.035, RH = { 10.72, 1 } },
						[67] = { 1, LH = { 20.1, 1 } },
						[293] = { 1, RH = { 306.4, 1 } },
						[360] = { 1.035, LH = { 346.6, 1.035 } }
					}
				},
				TXf = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "TBlur", Source = "Output", },
						Size = Input { Expression = "1 + 0.035 * (1 - min(min(max((time - comp.RenderStart) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1), min(max((comp.RenderEnd - time) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1)))", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 49 } },
				},
				MG1Blend = BezierSpline {
					SplineColor = { Red = 138, Green = 226, Blue = 52 },
					NameSet = true,
					KeyFrames = {
						[0] = { 0, RH = { 10.72, 1 } },
						[67] = { 1, LH = { 20.1, 1 } },
						[293] = { 1, RH = { 306.4, 1 } },
						[360] = { 0, LH = { 346.6, 0 } }
					}
				},
				MG1 = Merge {
					CtrlWZoom = false,
					Inputs = {
						Background = Input { SourceOp = "BG", Source = "Output", },
						Foreground = Input { SourceOp = "TXf", Source = "Output", },
						Blend = Input { Expression = "min(min(max((time - comp.RenderStart) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1), min(max((comp.RenderEnd - time) / min(67, max((comp.RenderEnd - comp.RenderStart) * 0.2, 12)), 0), 1))", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -330, 82 } },
				},
				Stretch = KeyStretcher {
					CtrlWShown = false,
					Inputs = {
						Keyframes = Input { SourceOp = "MG1", Source = "Output", },
						SourceEnd = Input { Value = 360, },
						StretchStart = Input { Value = 67, },
