					Default = 1,
				},
				Input12 = InstanceInput {
					SourceOp = "TText",
					Source = "Center",
					Name = "Posición",
				}
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "MG1",
					Source = "Output",
					Name = "Output",
				}
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
				Flags = {
					AllowPan = false,
					ConnectedSnap = true,
					AutoSnap = true,
					RemoveRouters = true
				},
				Size = { 330, 66.4, 165, 24.2 },
				Direction = "Horizontal",
				PipeStyle = "Direct",
				Scale = 1,
				Offset = { 0, 0 }
			},
			Tools = ordered() {
				BG = Background {
					CtrlWZoom = false,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 2160, },
						Height = Input { Value = 3840, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 49 } },
				},
				TText = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 2160, },
						Height = Input { Value = 3840, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						StyledText = Input { Value = StyledText { Value = "Subtítulo" }, },
						Font = Input { Value = "Helvetica Neue", },
						Style = Input { Value = "Medium", },
						Size = Input { Value = 0.15, },
						LineSpacing = Input { Value = 1, },
						VerticalJustificationNew = Input { Value = 3, },
